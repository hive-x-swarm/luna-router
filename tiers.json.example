{"_comment":"Example tiers for the Luna router. Copy to tiers.json and fill in your own values. Never put an API key in this file — keys come from environment variables.","tiers":[{"adapter":"ollama_ssh","endpoint":"http://127.0.0.1:11434/v1/chat/completions","host":"<YOUR_PC_HOST>","kind":"local","model":"qwen3:8b","name":"tier0","port":11434,"reasoning_effort":"none"},{"api_key_env":"GROQ_API_KEY","endpoint":"https://api.groq.com/openai/v1/chat/completions","kind":"api","model":"llama-3.1-8b","name":"tier1"},{"api_key_env":"DEEPSEEK_API_KEY","endpoint":"https://api.deepseek.com/v1/chat/completions","kind":"api","model":"deepseek-chat","name":"tier2"},{"endpoint":"","kind":"plus","model":"plus-handoff","name":"tier3"}]}